{
  "name": "guardpaper-trading",
  "productName": "GuardPaper Trading",
  "version": "1.0.0",
  "description": "Garde-fou de discipline pour le swing trading forex (méthode MTF 2.0) : règles bloquantes, taille de position, journal et statistiques.",
  "main": "bureau/main.js",
  "private": true,
  "flatpak": {
    "id": "fr.guardpaper.GuardPaperTrading",
    "depot": "Jeff12873/guardpaper-trading"
  },
  "scripts": {
    "demarrer": "electron .",
    "flatpak": "sh outils/flatpak.sh",
    "appimage": "electron-builder --linux AppImage",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.guardpaper.GuardPaperTrading",
    "productName": "GuardPaper Trading",
    "artifactName": "guardpaper-trading-${version}.AppImage",
    "files": [
      "index.html",
      "calculs.js",
      "exemples.js",
      "glossaire.js",
      "icone.svg",
      "bureau/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "bureau/icone.png",
      "syncDesktopName": true
    }
  },
  "author": "Jeff12873",
  "desktopName": "guardpaper-trading.desktop"
}
